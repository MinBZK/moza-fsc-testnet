# Env-template directory-ui (dienstencatalogus). Invoeren in ZAD Operations Manager.
# Waarden hier = ZAD; de lokale harness (deploy/local/docker-compose.yaml, service
# `directory-ui`) gebruikt dezelfde NAMEN, andere adressen/paden.
LOG_TYPE=live
LOG_LEVEL=info
LISTEN_ADDRESS=0.0.0.0:8080
MONITORING_ADDRESS=0.0.0.0:8081
BASE_URL_PATH=/
# DIRECTORY_MANAGER_ADDRESS = de ZAD SNI-hostnaam van dirmgr op dezelfde deployment, met
# expliciete :443 (mesh-poort; ingress SNI-passthrough -> pod :8443). In de Operations Manager UI
# staat dit LETTERLIJK als alias met de $DEPLOYMENT_NAME-substitutievariabele (zie de waarde
# hieronder) — GEEN vaste "test"-hostnaam invullen: alleen de $DEPLOYMENT_NAME-vorm laat een preview
# (`pr-<n>`) deze config automatisch erven. Voor deployment `test` lost dit op naar
# https://dirmgr-test-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443.
#
# De harde eis op :443 zit hier NIET in directory-ui zelf: de "missing port in manager
# address"-fatal komt uit de manager (self-peer-validatie in manager/domain/peer/peer_new.go), en
# directory-ui geeft dit adres onveranderd aan z'n REST-client. Wat hier wél verplicht is:
# INVARIANT — deze waarde moet BYTE-IDENTIEK zijn aan DIRECTORY_MANAGER_ADDRESS van dirmgr, want ZAD
# merget aliases per deployment in één set; twee verschillende waarden voor dezelfde alias geven een
# "Conflicting alias"-fout bij het deployen.
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-$DEPLOYMENT_NAME-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443
# Certs (gemount via ZAD attachments): group-root + dezelfde directory-cert/key als dirmgr. Let op
# wat dat betekent: directory-ui authenticeert richting de manager ALS de directory-peer zelf
# (OIN 00000000000000000010) — het is dus geen aparte "lezer"-identiteit op de mesh, alleen een
# aparte pod. Zie docs/zad-directory-deploy.md, stap 3.
TLS_GROUP_ROOT_CERT=/etc/fsc/ca/root.pem
TLS_GROUP_CERT=/etc/fsc/out/directory/directory/cert.pem
TLS_GROUP_KEY=/etc/fsc/out/directory/directory/key.pem
