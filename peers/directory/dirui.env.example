# Env-template directory-ui (dienstencatalogus). Invoeren in ZAD Operations Manager.
# Waarden hier = ZAD; de lokale harness (deploy/local/docker-compose.yaml, service
# `directory-ui`) gebruikt dezelfde NAMEN, andere adressen/paden.
LOG_TYPE=live
LOG_LEVEL=info
LISTEN_ADDRESS=0.0.0.0:8080
MONITORING_ADDRESS=0.0.0.0:8081
BASE_URL_PATH=/
# DIRECTORY_MANAGER_ADDRESS = de ZAD SNI-hostnaam van dirmgr op dezelfde deployment, met
# expliciete :443 (mesh-poort; ingress SNI-passthrough -> pod :8443). OpenFSC eist een expliciete
# poort in het manager-adres, anders Fatal "missing port in manager address". In de Operations
# Manager UI staat dit als alias met $DEPLOYMENT_NAME; onderstaande waarde is een
# placeholder-voorbeeld voor deployment `test`.
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-test-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443
# Certs (gemount via ZAD attachments): group-root + dezelfde directory-cert/key als dirmgr
# (lezer-identiteit, geen eigen peer). Zie docs/zad-directory-deploy.md, stap 3.
TLS_GROUP_ROOT_CERT=/etc/fsc/ca/root.pem
TLS_GROUP_CERT=/etc/fsc/out/directory/directory/cert.pem
TLS_GROUP_KEY=/etc/fsc/out/directory/directory/key.pem
