# Env-template directory-manager (DIRECTORY-MODE). Invoeren in ZAD Operations Manager.
# Namen letterlijk uit open-fsc/helm/charts/open-fsc-manager/templates/deployment.yaml.
# Waarden hier = ZAD; de lokale harness (deploy/local) gebruikt dezelfde NAMEN, andere adressen.
LOG_TYPE=live
LOG_LEVEL=info
GROUP_ID=moza-fbs-test
# Directory-mode: eigen OIN als directory-peer, geen txlog.
DIRECTORY_PEER_ID=00000000000000000010
# SELF/DIRECTORY_MANAGER_ADDRESS = de ZAD SNI-hostnaam per deployment
# (dirmgr-<deployment>-<project>.<domein>). In de Operations Manager UI staat dit LETTERLIJK als
# alias met de $DEPLOYMENT_NAME-substitutievariabele (zie de waarde hieronder) — GEEN vast
# "test"-hostnaam invullen: alleen de $DEPLOYMENT_NAME-vorm laat een preview (`pr-<n>`) deze
# config automatisch erven. Voor deployment `test` lost dit op naar
# https://dirmgr-test-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443.
# Expliciete :443 verplicht: OpenFSC eist een poort in het manager-adres en faalt anders fataal
# op "missing port in manager address" bij het aanmaken van de self-peer
# (manager/domain/peer/peer_new.go — whitelist is exact {443, 8443}). :443 is de mesh-poort
# (ingress SNI-passthrough naar pod-poort 8443, niet 8443 zelf).
#
# INVARIANT: SELF_ADDRESS en DIRECTORY_MANAGER_ADDRESS moeten BYTE-IDENTIEK zijn. Daaraan hangt de
# directory-mode: `manager/cmd/serve.go` doet `if SelfAddress != DirectoryManagerAddress &&
# TxLogAPIAddress == "" -> Fatal("tx-log-api-address is required when the manager does not function
# as the directory")`. Eén typo of een ontbrekende `:443` in één van de twee geeft dus een crashloop
# met een foutmelding die naar txlog wijst i.p.v. naar de echte oorzaak. Beide worden met de hand in
# de UI ingevuld, dus dit is geen theoretisch risico.
DIRECTORY_MANAGER_ADDRESS=https://dirmgr-$DEPLOYMENT_NAME-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443
TX_LOG_API_ADDRESS=
SELF_ADDRESS=https://dirmgr-$DEPLOYMENT_NAME-mft-tp9.rig.prd1.gn2.quattro.rijksapps.nl:443
AUTO_SIGN_GRANTS=servicePublication,delegatedServicePublication
AUDITLOG_TYPE=stdout
# Listen-poorten (intern in de pod; mesh-endpoint extern via Route op :443).
LISTEN_ADDRESS_EXTERNAL=0.0.0.0:8443
LISTEN_ADDRESS_INTERNAL=0.0.0.0:9443
LISTEN_ADDRESS_INTERNAL_UNAUTHENTICATED=0.0.0.0:9444
MONITORING_ADDRESS=0.0.0.0:8080
# Database: ZAD managed Postgres (`postgresql-database`-service — GEEN eigen postgres-component).
# ZAD levert $DATABASE_SERVER_HOST/$DATABASE_SERVER_USER/$DATABASE_PASSWORD/$DATABASE_DB; een
# alias in de Operations Manager UI giet die in de DSN. De wrapper-image draait `migrate up` bij boot;
# de managed DB bestaat al (geen CREATE DATABASE nodig). sslmode=disable: intra-cluster managed
# DB is plaintext (zoals de berichtenbox-JDBC). Onderstaande waarde is illustratief.
STORAGE_POSTGRES_DSN=postgres://$DATABASE_SERVER_USER:$DATABASE_PASSWORD@$DATABASE_SERVER_HOST:5432/$DATABASE_DB?sslmode=disable
# Certs (gemount via ZAD attachments; paden == lokale harness).
# CRL: interim uit — gen-crl.sh levert een lege CRL zonder gepubliceerd distributiepunt.
# Zodra intermediate.crl als attachment op /etc/fsc/ca/intermediate.crl gemount is
# (group-config crl:), DISABLE_CRL_CHECKS weghalen en het CRL-pad zetten. FSC vereist
# CRL-support; dit moet dicht vóór ZAD go-live. Matcht de env in de Operations Manager UI — en leeft
# dáár, niet hier: git documenteert deze waarde, niets handhaaft 'm.
# TODO(#896): driftdetectie op de UI-projectconfig, inclusief deze gate.
DISABLE_CRL_CHECKS=true
TLS_GROUP_ROOT_CERT=/etc/fsc/ca/root.pem
TLS_GROUP_CERT=/etc/fsc/out/directory/directory/cert.pem
TLS_GROUP_KEY=/etc/fsc/out/directory/directory/key.pem
TLS_GROUP_TOKEN_CERT=/etc/fsc/out/directory/directory/cert.pem
TLS_GROUP_TOKEN_KEY=/etc/fsc/out/directory/directory/key.pem
TLS_GROUP_CONTRACT_CERT=/etc/fsc/out/directory/directory/cert.pem
TLS_GROUP_CONTRACT_KEY=/etc/fsc/out/directory/directory/key.pem
TLS_ROOT_CERT=/etc/fsc/internal/directory/ca/root.pem
TLS_CERT=/etc/fsc/internal/directory/directory/cert.pem
TLS_KEY=/etc/fsc/internal/directory/directory/key.pem
TLS_INTERNAL_UNAUTHENTICATED_ROOT_CERT=/etc/fsc/internal/directory/ca/root.pem
TLS_INTERNAL_UNAUTHENTICATED_CERT=/etc/fsc/internal/directory/directory/cert.pem
TLS_INTERNAL_UNAUTHENTICATED_KEY=/etc/fsc/internal/directory/directory/key.pem
