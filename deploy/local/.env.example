# Kopieer naar deploy/local/.env (gitignored).
IMAGE_TAG=v2.5.2
# Pad naar onze test-CA-output. Read-only gemount op /pki in de containers.
PKI_DIR=../../pki
# Host-UID/GID: de cert-lezende pods draaien hiermee, zodat ze de 0600-privékeys
# lezen via de owner-bit (keys blijven dicht). Zet op je eigen waarden:
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> deploy/local/.env
HOST_UID=1000
HOST_GID=1000
# Wachtwoord van de lokale postgres. BEWUST geen default in docker-compose.yaml: deze repo is
# publiek en dient als template voor peer-teams, dus een hardgecodeerde `postgres:postgres` reist
# mee naar omgevingen waar "het is toch maar lokaal" niet meer opgaat. Compose faalt nu met een
# leesbare melding als deze regel ontbreekt, in plaats van stil een bekend wachtwoord te gebruiken.
# `run-smokes.sh` genereert 'm bij een eerste run; met de hand kan ook:
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 16)" >> deploy/local/.env
# De waarde hieronder is een placeholder — vervang 'm.
POSTGRES_PASSWORD=vervang-mij
