.env
# `.env` matcht alléén een bestand met exact die naam. De env-templates heten
# `<component>.env.example` (peers/directory/manager.env.example, dirui.env.example) en nodigen dus
# uit tot een ingevulde `<component>.env` met DSN + wachtwoord ernaast — die viel hierbuiten.
*.env
!*.env.example
*.pem
*.key
*.crt
*.crl
# Keystores/containerformaten met privésleutel erin (naast de losse *.pem/*.key hierboven).
*.p12
*.pfx
*.jks
*.der
*.pk8
secrets/
pki/ca/
pki/out/
pki/internal/
pki/zad-upload/
peers/**/values.yaml
group/group-config.yaml

# IDE
.idea/
*.iml
.vscode/
.superpowers/

# Claude Code agent-lokale werkmap (worktrees, sessie-state) — nooit committen.
.claude/

# Contract-bootstrap state (content_hash van geaccepteerde contracten; host-lokaal, niet-geheim).
contracts/.bootstrap-state/

# Core dumps (bv. van een gecrasht CLI-proces in de repo-cwd) — nooit committen.
core
core.*
